# 白话编译器，用白话自己写的。
# 把 .bh 程序翻译成 C，再调用系统的 C 编译器，得到一个可以直接运行的程序。
#
# 用法：
#     baihuac 程序.bh               生成可执行文件「程序」
#     baihuac 程序.bh -o 名字       指定可执行文件的名字
#     baihuac --emit-c 程序.bh      只生成 C 代码（程序.c），不调用 C 编译器
#
# 三个步骤，下面的代码也按这个顺序排：
#     源代码 -> 【一、词法分析】-> 记号 -> 【二、语法分析】-> 语法树 -> 【三、生成代码】-> C 程序

# ======================================================================
# 一、词法分析：把一长串字符切成一个个记号
# ======================================================================
# 一个记号是【种类，值，行号，原样写法】。
# 种类：NUM 数字、STR 文字、NAME 名字、KW 关键字、OP 运算符和标点、
#       NEWLINE 一行结束、INDENT 缩进增加、DEDENT 缩进减少、EOF 程序结束

关键字表 = 【“函数”，“返回”，“全局”，“如果”，“否则”，“否则如果”，“当”，“对于”，“里的每个”，“中的每个”，“重复”，“次”，“跳出”，“继续”，“真”，“假”，“空”】

# 用文字写的运算符，词法分析时直接换成对应的符号
文字运算符 = 【“除以”，“大于”，“小于”，“大于等于”，“小于等于”，“等于”，“是”，“不等于”，“并且”，“或者”，“不是”】
对应符号 = 【“/”，“>”，“<”，“>=”，“<=”，“==”，“==”，“!=”，“and”，“or”，“not”】

# 两个字以上的关键字，长的排前面。报错时用来猜「是不是忘了加空格」
长关键字 = 【】
对于 【4，3，2】 里的每个 字数：
    对于 关键字表 + 文字运算符 里的每个 词：
        如果 长度（词） 是 字数：
            添加（长关键字，词）

# 中文标点 -> 英文标点。全角的 （ ） ， ： ； ！ ＝ 可以用编码换算（见 半角），这里只列换算不了的
全角表 = 【“【”，“】”，“、”，“。”，“《”，“》”，“×”，“÷”，“≤”，“≥”，“≠”，字符（12288），字符（160），字符（8203），字符（65279）】
半角表 = 【“[”，“]”，“,”，“;”，“<”，“>”，“*”，“/”，“<=”，“>=”，“!=”，“ ”，“ ”，“ ”，“ ”】

# 行首的空白各算几格缩进：全角空格算两格，Tab 算四格
缩进字符 = 【“ ”，“\t”，字符（12288），字符（160），字符（8203），字符（65279）】
缩进宽度 = 【1，4，2，1，0，0】
空白字符 = 【“ ”，“\t”，“\n”，字符（13），字符（11），字符（12），字符（12288），字符（160）】

# 开头的引号，以及各自可以用什么来结尾
引号开 = 【“"”，“'”，「“」，「”」，“‘”，“’”，“「”，“『”】
引号关 = 【“"”，“'”，「”“」，「”“」，“’‘”，“’‘”，“」”，“』”】

双字符号 = 【“==”，“!=”，“<=”，“>=”，“+=”，“-=”，“*=”，“/=”】
单字符号 = “+-*/%=<>!()[],:;”
赋值符号 = 【“=”，“+=”，“-=”，“*=”，“/=”】
比较符号 = 【“==”，“!=”，“<”，“>”，“<=”，“>=”】

# 名字里可以出现的文字，一对一对的编码范围：汉字、英文字母、带声调的拉丁字母、
# 希腊和西里尔字母、假名、谚文
字母范围 = 【19968，40959，65，90，97，122，192，214，216，246，248，591，880，1023，1024，1327，12353，12447，12449，12543，13312，19903，44032，55203，63744，64255，131072，201551】

源码行表 = 【】


函数 半角（字）：
    # 把中文（全角）符号换成对应的英文（半角）符号，其他字符原样返回
    下标 = 查找（全角表，字）
    如果 下标 大于等于 0：
        返回 半角表【下标】
    码 = 编码（字）
    如果 码 大于等于 65281 并且 码 小于等于 65374：
        返回 字符（码 - 65248）
    返回 字


函数 是字母（字）：
    如果 长度（字） 不是 1：
        返回 假
    码 = 编码（字）
    下标 = 0
    当 下标 小于 长度（字母范围）：
        如果 码 大于等于 字母范围【下标】 并且 码 小于等于 字母范围【下标 + 1】：
            返回 真
        下标 += 2
    返回 假


函数 是数字（字）：
    返回 长度（字） 是 1 并且 编码（字） 大于等于 48 并且 编码（字） 小于等于 57


函数 名字字符（字）：
    返回 是字母（字） 或者 字 是 “_” 或者 是数字（字）


函数 去空白（文）：
    头 = 0
    尾 = 长度（文）
    当 头 小于 尾 并且 查找（空白字符，文【头】） 大于等于 0：
        头 += 1
    当 尾 大于 头 并且 查找（空白字符，文【尾 - 1】） 大于等于 0：
        尾 -= 1
    返回 截取（文，头，尾 - 头）


函数 半角串（文本，起，止）：
    片 = 【】
    下标 = 起
    当 下标 小于 止：
        添加（片，半角（文本【下标】））
        下标 += 1
    返回 连接（片）


函数 去前导零（文）：
    头 = 0
    当 头 小于 长度（文） - 1 并且 文【头】 是 “0”：
        头 += 1
    返回 截取（文，头，长度（文） - 头）


函数 语法出错（消息，行）：
    # 报出语法错误，指出是哪一行，然后结束编译
    报错（“语法错误（第 ” + 行 + “ 行）：” + 消息）
    如果 行 大于等于 1 并且 行 小于等于 长度（源码行表）：
        这行 = 去空白（源码行表【行 - 1】）
        如果 这行 不是 “”：
            报错（“  >  ” + 这行）
    退出（1）


函数 空格提示（名字们）：
    # 中文没有空格，很容易把关键字和名字连着写。名字里夹着关键字时给一句提示
    对于 名字们 里的每个 名字：
        对于 长关键字 里的每个 词：
            如果 查找（名字，词） 大于等于 0 并且 词 不是 名字：
                返回 “\n提示：「” + 名字 + “」被当成了一个名字。如果其中的「” + 词 + “」是单独的一个词，要在它前后加上空格。”
    返回 “”


函数 词法分析（）：
    记号表 = 【】
    缩进栈 = 【0】          # 每进入一层代码块，就把那一层的缩进宽度压进来
    括号栈 = 【】           # 还没关上的括号。括号里面可以随便换行
    行号 = 0
    对于 源码行表 里的每个 文本：
        行号 += 1
        位置 = 0
        总长 = 长度（文本）

        如果 长度（括号栈） 是 0：
            # 一行的开头：量一量缩进
            宽度 = 0
            当 位置 小于 总长 并且 查找（缩进字符，文本【位置】） 大于等于 0：
                宽度 += 缩进宽度【查找（缩进字符，文本【位置】）】
                位置 += 1
            如果 位置 是 总长 或者 半角（文本【位置】） 是 “#”：
                继续                      # 空行和整行注释直接跳过
            如果 宽度 大于 缩进栈【-1】：
                添加（缩进栈，宽度）
                添加（记号表，【“INDENT”，空，行号，“”】）
            否则：
                当 宽度 小于 缩进栈【-1】：
                    删除（缩进栈，-1）
                    添加（记号表，【“DEDENT”，空，行号，“”】）
                如果 宽度 不是 缩进栈【-1】：
                    语法出错（“缩进对不齐：这一行开头的空格数和前面哪一层都对不上”，行号）

        当 位置 小于 总长：
            原字 = 文本【位置】             # 原始字符，可能是全角的
            字 = 半角（原字）               # 换算成半角之后的样子

            如果 字 是 “ ” 或者 字 是 “\t”：
                位置 += 1

            否则如果 字 是 “#”：            # 注释：从 # 到行尾都不看
                跳出

            否则如果 查找（引号开，原字） 大于等于 0 或者 查找（引号开，字） 大于等于 0：
                # 文字。引号里面的内容原样保留
                号 = 查找（引号开，原字）
                如果 号 小于 0：
                    号 = 查找（引号开，字）
                结尾们 = 引号关【号】
                内容 = 【】
                指针 = 位置 + 1
                当 指针 小于 总长 并且 查找（结尾们，文本【指针】） 小于 0 并且 查找（结尾们，半角（文本【指针】）） 小于 0：
                    如果 文本【指针】 是 “\\” 并且 指针 + 1 小于 总长：
                        指针 += 1               # 反斜杠转义：\n 换行，\t 制表符
                        转义 = 文本【指针】
                        如果 转义 是 “n”：
                            添加（内容，“\n”）
                        否则如果 转义 是 “t”：
                            添加（内容，“\t”）
                        否则：
                            添加（内容，转义）
                    否则：
                        添加（内容，文本【指针】）
                    指针 += 1
                如果 指针 大于等于 总长：
                    语法出错（“文字的引号没有关上（开头的引号是 ” + 原字 + “ ）”，行号）
                添加（记号表，【“STR”，连接（内容），行号，截取（文本，位置，指针 + 1 - 位置）】）
                位置 = 指针 + 1

            否则如果 是数字（字）：
                指针 = 位置
                当 指针 小于 总长 并且 是数字（半角（文本【指针】））：
                    指针 += 1
                数值 = 半角串（文本，位置，指针）
                # 小数点：中文输入法可能把 . 打成 。 只要它后面紧跟着数字，就当小数点
                如果 指针 + 1 小于 总长 并且 查找（“.。．”，文本【指针】） 大于等于 0 并且 是数字（半角（文本【指针 + 1】））：
                    尾 = 指针 + 1
                    当 尾 小于 总长 并且 是数字（半角（文本【尾】））：
                        尾 += 1
                    数值 = 数值 + “.” + 半角串（文本，指针 + 1，尾）
                    指针 = 尾
                否则：
                    数值 = 去前导零（数值）
                添加（记号表，【“NUM”，数值，行号，截取（文本，位置，指针 - 位置）】）
                位置 = 指针

            否则如果 是字母（字） 或者 字 是 “_”：
                # 一串连续的汉字、字母、数字、下划线：可能是名字、关键字或文字运算符
                指针 = 位置
                当 指针 小于 总长 并且 名字字符（半角（文本【指针】））：
                    指针 += 1
                词 = 半角串（文本，位置，指针）
                号 = 查找（文字运算符，词）
                如果 号 大于等于 0：
                    添加（记号表，【“OP”，对应符号【号】，行号，词】）
                否则如果 查找（关键字表，词） 大于等于 0：
                    添加（记号表，【“KW”，词，行号，词】）
                否则：
                    添加（记号表，【“NAME”，词，行号，词】）
                位置 = 指针

            否则：
                后一个 = “”
                如果 位置 + 1 小于 总长：
                    后一个 = 半角（文本【位置 + 1】）
                如果 长度（字） 是 2：                                  # ≤ ≥ ≠ 这种一个字符顶两个的
                    符号 = 字
                    占 = 1
                否则如果 查找（双字符号，字 + 后一个） 大于等于 0：      # == != <= >= += 等
                    符号 = 字 + 后一个
                    占 = 2
                否则如果 查找（单字符号，字） 大于等于 0：
                    符号 = 字
                    占 = 1
                否则：
                    语法出错（“不认识的符号「” + 原字 + “」”，行号）
                如果 符号 是 “(” 或者 符号 是 “[”：
                    添加（括号栈，【符号，原字，行号】）
                否则如果 符号 是 “)” 或者 符号 是 “]”：
                    如果 长度（括号栈） 是 0：
                        语法出错（“多了一个「” + 原字 + “」，前面没有和它配对的括号”，行号）
                    开 = 括号栈【-1】
                    删除（括号栈，-1）
                    如果 （开【0】 是 “(”） 不是 （符号 是 “)”）：
                        语法出错（“括号没有配对：「” + 开【1】 + “」不能用「” + 原字 + “」来关”，行号）
                添加（记号表，【“OP”，符号，行号，截取（文本，位置，占）】）
                位置 += 占

        如果 长度（括号栈） 是 0：
            添加（记号表，【“NEWLINE”，空，行号，“”】）

    如果 长度（括号栈） 大于 0：
        开 = 括号栈【-1】
        语法出错（“括号「” + 开【1】 + “」没有关上”，开【2】）
    重复 长度（缩进栈） - 1 次：
        添加（记号表，【“DEDENT”，空，长度（源码行表），“”】）
    添加（记号表，【“EOF”，空，长度（源码行表），“”】）
    返回 记号表


# ======================================================================
# 二、语法分析：把记号排成一棵语法树
# ======================================================================
# 递归下降：每个「解析××」函数负责认出一种语法结构，返回一个节点。
# 节点是【种类，行号，其他内容……】，例如：
#     【“num”，3，“42”】                    第 3 行的数字 42
#     【“binop”，3，“+”，左边，右边】        第 3 行的一次加法
#
# 表达式的优先级，从低到高：
#     或者 < 并且 < 不是 < 比较 < + - < * / % < 负号 < 调用和下标

记号 = 【】
游标 = 0
循环层数 = 0          # 现在套在几层循环里（检查「跳出」「继续」用）
函数层数 = 0          # 现在套在几层函数里（检查「返回」用）


函数 看（）：
    返回 记号【游标】


函数 前进（）：
    全局 游标
    这个 = 记号【游标】
    如果 这个【0】 不是 “EOF”：
        游标 += 1
    返回 这个


函数 是这个（种类，值）：
    # 当前记号是不是这个种类、这个值。值给「空」表示不管值是什么
    这个 = 记号【游标】
    如果 这个【0】 不是 种类：
        返回 假
    返回 值 是 空 或者 这个【1】 是 值


函数 接受（种类，值）：
    如果 是这个（种类，值）：
        返回 前进（）
    返回 空


函数 说（某记号）：
    # 把一个记号说成人话，报错时用
    种类 = 某记号【0】
    如果 种类 是 “NEWLINE”：返回 “换行”
    如果 种类 是 “INDENT”：返回 “缩进”
    如果 种类 是 “DEDENT”：返回 “缩进的结束”
    如果 种类 是 “EOF”：返回 “程序的结尾”
    返回 “「” + 某记号【3】 + “」”


函数 语法错（消息）：
    这个 = 记号【游标】
    行 = 这个【2】
    如果 这个【0】 是 “EOF” 并且 游标 大于 0：       # 程序突然结束：指向最后一行有内容的地方
        行 = 记号【游标 - 1】【2】
    名字们 = 【】
    对于 记号 里的每个 某个：
        如果 某个【0】 是 “NAME” 并且 某个【2】 是 行：
            添加（名字们，某个【1】）
    语法出错（消息 + 空格提示（名字们），行）


函数 期待（种类，值）：
    如果 不是 是这个（种类，值）：
        想要 = “「” + 值 + “」”
        如果 值 是 “:”：想要 = “冒号「：」”
        如果 值 是 “(”：想要 = “左括号「（」”
        如果 值 是 “)”：想要 = “右括号「）」”
        如果 值 是 “]”：想要 = “右方括号「】」”
        语法错（“这里需要” + 想要 + “，但出现的是” + 说（看（）））
    返回 前进（）


函数 期待名字（什么）：
    这个 = 看（）
    如果 这个【0】 是 “NAME”：
        返回 前进（）【1】
    如果 这个【0】 是 “KW” 或者 查找（文字运算符，这个【3】） 大于等于 0：
        语法错（“「” + 这个【3】 + “」是白话语言自己要用的词，不能拿来当” + 什么）
    语法错（“这里需要一个” + 什么 + “，但出现的是” + 说（这个））


函数 语句结束了（）：
    返回 是这个（“NEWLINE”，空） 或者 是这个（“EOF”，空） 或者 是这个（“OP”，“;”）


函数 并入（表，新的）：
    对于 新的 里的每个 项：
        添加（表，项）


# ---------- 语句 ----------

函数 解析程序（）：
    语句表 = 【】
    当 不是 是这个（“EOF”，空）：
        并入（语句表，解析语句（））
    返回 语句表


函数 解析语句（）：
    # 解析一行。返回列表，因为一行里可以用 ； 或 。 隔开写好几句
    这个 = 看（）
    如果 这个【0】 是 “INDENT”：
        语法错（“这一行不该缩进：只有冒号下面的内容才需要缩进”）
    如果 这个【0】 是 “KW”：
        词 = 这个【1】
        如果 词 是 “如果”：返回 【解析如果（）】
        如果 词 是 “当”：返回 【解析当（）】
        如果 词 是 “对于”：返回 【解析对于（）】
        如果 词 是 “重复”：返回 【解析重复（）】
        如果 词 是 “函数”：返回 【解析函数（）】
    返回 解析简单行（）


函数 解析简单行（）：
    语句表 = 【解析简单语句（）】
    当 接受（“OP”，“;”）：
        如果 是这个（“NEWLINE”，空） 或者 是这个（“EOF”，空）：
            跳出                              # 行尾的句号或分号，可写可不写
        添加（语句表，解析简单语句（））
    如果 不是 （是这个（“EOF”，空） 或者 接受（“NEWLINE”，空））：
        这个 = 看（）
        消息 = “这一句到这里应该结束了，但后面还有” + 说（这个）
        最后 = 语句表【-1】
        如果 最后【0】 是 “expr” 并且 最后【2】【0】 是 “name” 并且 查找（【“NUM”，“STR”，“NAME”】，这个【0】） 大于等于 0：
            名 = 最后【2】【2】
            消息 = 消息 + “\n提示：如果是想调用「” + 名 + “」，要加括号，例如：” + 名 + “（” + 这个【3】 + “）”
        否则如果 这个【3】 是 “、”：
            消息 = 消息 + “\n提示：顿号在这里相当于逗号。如果想做除法，请写 / 或者「除以」。”
        语法错（消息）
    返回 语句表


函数 解析简单语句（）：
    这个 = 看（）
    行 = 这个【2】
    如果 这个【0】 是 “KW”：
        词 = 这个【1】
        如果 词 是 “返回”：
            如果 函数层数 是 0：
                语法错（“「返回」只能写在函数里面”）
            前进（）
            值 = 空
            如果 不是 语句结束了（）：
                值 = 解析表达式（）
            返回 【“return”，行，值】
        如果 词 是 “跳出” 或者 词 是 “继续”：
            如果 循环层数 是 0：
                语法错（“「” + 词 + “」只能写在循环里面”）
            前进（）
            如果 词 是 “跳出”：
                返回 【“break”，行】
            返回 【“continue”，行】
        如果 词 是 “全局”：
            前进（）
            名字们 = 【期待名字（“变量名”）】
            当 接受（“OP”，“,”）：
                添加（名字们，期待名字（“变量名”））
            返回 【“global”，行，名字们】

    式 = 解析表达式（）
    符 = 看（）
    如果 符【0】 是 “OP” 并且 查找（赋值符号，符【1】） 大于等于 0：
        如果 式【0】 不是 “name” 并且 式【0】 不是 “index”：
            语法错（“「” + 符【3】 + “」的左边只能是名字，或者 列表【下标】”）
        前进（）
        返回 【“assign”，行，式，符【1】，解析表达式（）】
    返回 【“expr”，行，式】


函数 解析块（）：
    # 冒号后面的代码块：换行后缩进的若干行，或者直接写在同一行的一句
    如果 是这个（“OP”，“=”）：
        语法错（“判断是否相等要写「==」「等于」或者「是」，单独一个「=」是赋值”）
    期待（“OP”，“:”）
    如果 不是 是这个（“NEWLINE”，空）：
        返回 解析简单行（）
    前进（）
    如果 不是 接受（“INDENT”，空）：
        语法错（“冒号下面的内容需要缩进（开头空四格）”）
    语句表 = 【】
    当 不是 是这个（“DEDENT”，空） 并且 不是 是这个（“EOF”，空）：
        并入（语句表，解析语句（））
    接受（“DEDENT”，空）
    返回 语句表


函数 解析循环体（）：
    全局 循环层数
    循环层数 += 1
    体 = 解析块（）
    循环层数 -= 1
    返回 体


函数 解析如果（）：
    行 = 前进（）【2】                        # 吃掉「如果」
    条件 = 解析表达式（）
    分支们 = 【【条件，解析块（）】】
    别的 = 空
    当 真：
        如果 接受（“KW”，“否则如果”）：
            条件 = 解析表达式（）
            添加（分支们，【条件，解析块（）】）
        否则如果 接受（“KW”，“否则”）：
            如果 接受（“KW”，“如果”）：          # 「否则 如果」中间有空格也行
                条件 = 解析表达式（）
                添加（分支们，【条件，解析块（）】）
            否则：
                别的 = 解析块（）
                跳出
        否则：
            跳出
    返回 【“if”，行，分支们，别的】


函数 解析当（）：
    行 = 前进（）【2】
    条件 = 解析表达式（）
    返回 【“while”，行，条件，解析循环体（）】


函数 解析对于（）：
    行 = 前进（）【2】
    来源 = 解析表达式（）
    如果 不是 （接受（“KW”，“里的每个”） 或者 接受（“KW”，“中的每个”））：
        语法错（“「对于」的写法是：对于 列表 里的每个 名字：”）
    名 = 期待名字（“变量名”）
    返回 【“foreach”，行，来源，名，解析循环体（）】


函数 解析重复（）：
    行 = 前进（）【2】
    次数 = 解析表达式（）
    如果 不是 接受（“KW”，“次”）：
        语法错（“「重复」的写法是：重复 3 次：”）
    返回 【“repeat”，行，次数，解析循环体（）】


函数 解析函数（）：
    全局 循环层数，函数层数
    行 = 前进（）【2】
    名 = 期待名字（“函数名”）
    期待（“OP”，“(”）
    参数们 = 【】
    当 不是 是这个（“OP”，“)”）：
        参数 = 期待名字（“参数名”）
        如果 查找（参数们，参数） 大于等于 0：
            语法错（“参数名「” + 参数 + “」重复了”）
        添加（参数们，参数）
        如果 不是 接受（“OP”，“,”）：
            跳出
    期待（“OP”，“)”）
    # 函数体是一个全新的环境：外面的循环管不到里面的「跳出」
    外面的循环 = 循环层数
    循环层数 = 0
    函数层数 += 1
    体 = 解析块（）
    函数层数 -= 1
    循环层数 = 外面的循环
    返回 【“def”，行，名，参数们，体】


# ---------- 表达式：优先级越低的越先被调用 ----------

函数 解析表达式（）：
    返回 解析或（）


函数 解析或（）：
    左 = 解析且（）
    当 是这个（“OP”，“or”）：
        行 = 前进（）【2】
        左 = 【“or”，行，左，解析且（）】
    返回 左


函数 解析且（）：
    左 = 解析非（）
    当 是这个（“OP”，“and”）：
        行 = 前进（）【2】
        左 = 【“and”，行，左，解析非（）】
    返回 左


函数 解析非（）：
    如果 是这个（“OP”，“not”） 或者 是这个（“OP”，“!”）：
        行 = 前进（）【2】                    # 写在最前面的「不是」：取反
        返回 【“not”，行，解析非（）】
    返回 解析比较（）


函数 解析比较（）：
    首 = 解析加减（）
    行 = 看（）【2】
    其余 = 【】
    当 真：
        这个 = 看（）
        如果 这个【0】 是 “OP” 并且 查找（比较符号，这个【1】） 大于等于 0：
            符 = 这个【1】
        否则如果 这个【0】 是 “OP” 并且 这个【1】 是 “not”：
            符 = “!=”                         # 夹在两个值中间的「不是」：不等于
        否则：
            跳出
        前进（）
        添加（其余，【符，解析加减（）】）
    如果 长度（其余） 是 0：
        返回 首
    返回 【“compare”，行，首，其余】          # 可以连着比：1 小于 x 小于 10


函数 解析加减（）：
    左 = 解析乘除（）
    当 看（）【0】 是 “OP” 并且 （看（）【1】 是 “+” 或者 看（）【1】 是 “-”）：
        这个 = 前进（）
        左 = 【“binop”，这个【2】，这个【1】，左，解析乘除（）】
    返回 左


函数 解析乘除（）：
    左 = 解析一元（）
    当 看（）【0】 是 “OP” 并且 查找（【“*”，“/”，“%”】，看（）【1】） 大于等于 0：
        这个 = 前进（）
        左 = 【“binop”，这个【2】，这个【1】，左，解析一元（）】
    返回 左


函数 解析一元（）：
    如果 是这个（“OP”，“-”）：
        行 = 前进（）【2】
        返回 【“neg”，行，解析一元（）】
    返回 解析后缀（）


函数 解析后缀（）：
    节点 = 解析基本（）
    当 真：
        如果 是这个（“OP”，“(”）：             # 函数调用：名字（参数，参数）
            行 = 前进（）【2】
            节点 = 【“call”，行，节点，解析一串（“)”）】
        否则如果 是这个（“OP”，“[”）：         # 取下标：列表【0】
            行 = 前进（）【2】
            下标 = 解析表达式（）
            期待（“OP”，“]”）
            节点 = 【“index”，行，节点，下标】
        否则：
            返回 节点


函数 解析一串（收尾）：
    # 解析用逗号隔开的一串表达式，直到遇见右括号
    项们 = 【】
    当 不是 是这个（“OP”，收尾）：
        添加（项们，解析表达式（））
        如果 不是 接受（“OP”，“,”）：
            跳出
    期待（“OP”，收尾）
    返回 项们


函数 解析基本（）：
    这个 = 看（）
    种类 = 这个【0】
    如果 种类 是 “NUM”：
        前进（）
        返回 【“num”，这个【2】，这个【1】】
    如果 种类 是 “STR”：
        前进（）
        返回 【“str”，这个【2】，这个【1】】
    如果 种类 是 “NAME”：
        前进（）
        返回 【“name”，这个【2】，这个【1】】
    如果 种类 是 “KW” 并且 （这个【1】 是 “真” 或者 这个【1】 是 “假” 或者 这个【1】 是 “空”）：
        前进（）
        返回 【“const”，这个【2】，这个【1】】
    如果 种类 是 “OP” 并且 这个【1】 是 “(”：
        前进（）
        式 = 解析表达式（）
        期待（“OP”，“)”）
        返回 式
    如果 种类 是 “OP” 并且 这个【1】 是 “[”：       # 列表：【1，2，3】  字典：【“甲”：1，“乙”：2】  空字典：【：】
        前进（）
        如果 接受（“OP”，“:”）：
            期待（“OP”，“]”）
            返回 【“dict”，这个【2】，【】】
        如果 接受（“OP”，“]”）：
            返回 【“list”，这个【2】，【】】
        首 = 解析表达式（）
        如果 不是 接受（“OP”，“:”）：
            项们 = 【首】
            如果 接受（“OP”，“,”）：
                并入（项们，解析一串（“]”））
            否则：
                期待（“OP”，“]”）
            返回 【“list”，这个【2】，项们】
        对们 = 【【首，解析表达式（）】】
        当 接受（“OP”，“,”）：
            如果 是这个（“OP”，“]”）：
                跳出
            键 = 解析表达式（）
            期待（“OP”，“:”）
            添加（对们，【键，解析表达式（）】）
        期待（“OP”，“]”）
        返回 【“dict”，这个【2】，对们】
    如果 种类 是 “KW”：
        语法错（“「” + 这个【3】 + “」不能出现在这里（它是白话语言的关键字，也不能当名字用）”）
    语法错（“这里缺了一个值，出现的是” + 说（这个））


# ======================================================================
# 三、生成代码：沿着语法树走一遍，写出对应的 C 代码
# ======================================================================
# 每个子表达式的结果都先放进一个临时变量，再拿去用。
# 这样写出来的 C 很啰嗦，但求值的先后顺序和白话程序一模一样。
# 一句话执行完，它用过的临时变量就可以给下一句接着用。
#
# 临时变量有两种：
#     t0、t1……   普通的 C 局部变量，C 编译器可以把它们放进寄存器，最快
#     T[0]……     登记给垃圾回收器的数组里的一格
# 回收只会发生在调用函数和循环转圈的时候。一个值如果在算后面的东西时还要留着，
# 而后面那些东西里有函数调用，就得先把它挪进 T，免得被当成垃圾收走（见「保根」）。
#
# 没有循环、也不调用别的白话函数的函数叫「叶子函数」：执行过程中不可能回收，
# 连变量都不用登记，和普通的 C 函数一样快。
# 调用内置函数（而且这个名字在程序里从来没被赋过值）时，直接调用 C 写的那个函数。
#
# 变量放在哪里：
#     最外层的变量     C 数组 G 里的一格
#     函数里的变量     C 数组 L 里的一格。如果函数里面还定义了函数，L 就放到堆上，
#                      内层函数通过 up 指针找到它
# 规则和解释器完全一样：读变量时从里往外找；在函数里赋值只影响函数自己的变量，
# 想改最外层的变量，要先写「全局 名字」。

全局名表 = 【】          # 最外层变量的名字，下标就是它在 G 里的位置
常量表 = 【】            # 程序里出现过的文字和大整数，下标就是它在 K 里的位置（开头一个字标明是「文」还是「数」）
函数成品 = 【】          # 每个函数生成好的 C 代码
函数个数 = 0
环境 = 空                # 正在编译的那个函数的信息，是下面这样的一张表
内置名表 = 【】          # 运行时里有哪些内置函数（从运行时的源码里读出来）
内置表 = 【】            # 和内置名表一一对应：【名字，C 函数名，最少几个参数，最多几个参数】
全局被赋值 = 【】        # 程序里哪些最外层的名字被赋过值（这样的名字不能当成内置函数直接调用）
直接调用过 = 【】        # 直接调用过哪些内置函数

# 环境这张表里各个位置的含义
代码位 = 0               # 已经生成的 C 代码，一行一项
局部位 = 1               # 函数里的变量名，下标就是它在 L 里的位置（参数排在最前面）
参数位 = 2               # 有几个参数
声明位 = 3               # 用「全局」声明过的名字
内层位 = 4               # 函数里面是不是还定义了函数
临时位 = 5               # 已经用掉几个临时变量
行位 = 6                 # C 代码里的 bh_line 现在是几（-1 表示不确定）
外层位 = 7               # 外面一层的环境
模块位 = 8               # 是不是最外层
缩进位 = 9               # 生成的 C 代码缩进几层
最多位 = 10              # 普通临时变量最多同时用到几个
整型位 = 11              # 已经用掉几个 C 的整型变量（循环计数用）
根位 = 12                # 已经用掉几个登记过的临时变量（T 里的格）
最多根位 = 13            # 登记过的临时变量最多同时用到几个（决定数组 T 要多大）
叶子位 = 14              # 是不是叶子函数


函数 新环境（外层，局部，参数数，声明，有内层，是模块）：
    返回 【【】，局部，参数数，声明，有内层，0，-1，外层，是模块，1，0，0，0，0，假】


函数 出（文本）：
    添加（环境【代码位】，“    ” * 环境【缩进位】 + 文本）


函数 开块（文本）：
    出（文本）
    环境【缩进位】 += 1


函数 关块（）：
    环境【缩进位】 -= 1
    出（“}”）
    环境【行位】 = -1


函数 否则块（）：
    环境【缩进位】 -= 1
    出（“} else {”）
    环境【缩进位】 += 1
    环境【行位】 = -1


函数 新临时（）：
    # 普通的临时变量：C 的局部变量 t0、t1……
    格 = 环境【临时位】
    环境【临时位】 += 1
    如果 环境【临时位】 大于 环境【最多位】：
        环境【最多位】 = 环境【临时位】
    返回 “t” + 格


函数 根临时（）：
    # 登记过的临时变量：数组 T 里的一格。函数开头会把这个数组登记给垃圾回收器
    如果 环境【叶子位】：
        报错（“编译器内部错误：叶子函数里不该需要登记临时变量”）
        退出（3）
    格 = 环境【根位】
    环境【根位】 += 1
    如果 环境【根位】 大于 环境【最多根位】：
        环境【最多根位】 = 环境【根位】
    返回 “T[” + 格 + “]”


函数 不用保护（式）：
    # 常数、已经登记过的格、函数自己的参数：不会被回收器收走
    头 = 截取（式，0，2）
    如果 头 是 “T[” 或者 头 是 “L[” 或者 头 是 “K[” 或者 头 是 “BH”：
        返回 真
    返回 截取（式，0，7） 是 “bh_int(” 或者 截取（式，0，9） 是 “bh_float(”


函数 保根（式）：
    # 这个值在算后面的东西时还要留着，而后面可能发生回收：挪进登记过的格里
    如果 不用保护（式）：
        返回 式
    格 = 根临时（）
    出（格 + “ = ” + 式 + “;”）
    返回 格


函数 新整型（）：
    环境【整型位】 += 1
    返回 “n” + 环境【整型位】


函数 定行（行）：
    # 出错时要报行号，所以执行到哪一行，就把行号记到 bh_line 里
    如果 环境【行位】 不是 行：
        出（“bh_line = ” + 行 + “;”）
        环境【行位】 = 行


函数 全局槽（名）：
    号 = 查找（全局名表，名）
    如果 号 小于 0：
        添加（全局名表，名）
        号 = 长度（全局名表） - 1
    返回 号


函数 常量槽（文）：
    号 = 查找（常量表，文）
    如果 号 小于 0：
        添加（常量表，文）
        号 = 长度（常量表） - 1
    返回 号


函数 C文字（文）：
    # 把一段文字写成 C 的字符串常量
    片 = 【“"”】
    对于 文 里的每个 字：
        码 = 编码（字）
        如果 字 是 “\\”：
            添加（片，“\\\\”）
        否则如果 字 是 “"”：
            添加（片，“\\"”）
        否则如果 字 是 “?”：
            添加（片，“\\?”）
        否则如果 字 是 “\n”：
            添加（片，“\\n”）
        否则如果 字 是 “\t”：
            添加（片，“\\t”）
        否则如果 码 小于 32 或者 码 是 127：
            添加（片，“\\” + 整数（码 / 64） + 整数（码 / 8） % 8 + 码 % 8）
        否则：
            添加（片，字）
    添加（片，“"”）
    返回 连接（片）


函数 数字常量（文本）：
    如果 查找（文本，“.”） 大于等于 0：
        返回 “bh_float(” + 文本 + “)”
    如果 长度（文本） 大于 18：                # 64 位可能装不下：当作大整数常量，程序启动时算好
        返回 “K[” + 常量槽（“数” + 文本） + “]”
    返回 “bh_int(” + 文本 + “LL)”


函数 至少一（数）：
    如果 数 小于 1：
        返回 1
    返回 数


函数 记下（表，名）：
    如果 查找（表，名） 小于 0：
        添加（表，名）


函数 收集（语句表，局部，声明，标记）：
    # 编译一个函数之前先扫一遍：哪些名字会被赋值（它们是这个函数自己的变量）、
    # 哪些名字声明过「全局」、里面有没有再定义函数（记在 标记【0】）
    对于 语句表 里的每个 句：
        种类 = 句【0】
        如果 种类 是 “assign”：
            如果 句【2】【0】 是 “name”：
                记下（局部，句【2】【2】）
        否则如果 种类 是 “if”：
            对于 句【2】 里的每个 分支：
                收集（分支【1】，局部，声明，标记）
            如果 句【3】 不是 空：
                收集（句【3】，局部，声明，标记）
        否则如果 种类 是 “while” 或者 种类 是 “repeat”：
            收集（句【3】，局部，声明，标记）
        否则如果 种类 是 “foreach”：
            记下（局部，句【3】）
            收集（句【4】，局部，声明，标记）
        否则如果 种类 是 “def”：
            记下（局部，句【2】）
            标记【0】 = 真
        否则如果 种类 是 “global”：
            对于 句【2】 里的每个 名：
                记下（声明，名）


函数 读内置表（运行时）：
    # 运行时的源码里有一张内置函数表：{"长度", bi_len, 1, 1}, ……  把它读出来
    全局 内置名表，内置表
    内置名表 = 【】
    内置表 = 【】
    起 = 查找（运行时，“bh_builtins[] = {”）
    止 = 查找（运行时，“{NULL, NULL”）
    如果 起 小于 0 或者 止 小于 起：
        返回
    片们 = 分割（截取（运行时，起，止 - 起），“{"”）
    下标 = 1
    当 下标 小于 长度（片们）：
        两半 = 分割（片们【下标】，“"”）
        项们 = 分割（分割（两半【1】，“}”）【0】，“,”）
        添加（内置名表，两半【0】）
        添加（内置表，【两半【0】，去空白（项们【1】），整数（项们【2】），整数（项们【3】）】）
        下标 += 1


函数 找函数（语句表，结果）：
    # 找出这些语句里（不算更里面的函数）定义的所有函数
    对于 语句表 里的每个 句：
        种类 = 句【0】
        如果 种类 是 “def”：
            添加（结果，句）
        否则如果 种类 是 “if”：
            对于 句【2】 里的每个 分支：
                找函数（分支【1】，结果）
            如果 句【3】 不是 空：
                找函数（句【3】，结果）
        否则如果 种类 是 “while” 或者 种类 是 “repeat”：
            找函数（句【3】，结果）
        否则如果 种类 是 “foreach”：
            找函数（句【4】，结果）


函数 找全局赋值（语句表，是模块）：
    # 最外层赋值的名字，以及函数里声明了「全局」又赋了值的名字，都会改动最外层的变量
    局部 = 【】
    声明 = 【】
    标记 = 【假】
    收集（语句表，局部，声明，标记）
    对于 局部 里的每个 名：
        如果 是模块 或者 查找（声明，名） 大于等于 0：
            记下（全局被赋值，名）
    里面的 = 【】
    找函数（语句表，里面的）
    对于 里面的 里的每个 句：
        找全局赋值（句【4】，假）


函数 直接内置（节点）：
    # 这次调用能不能直接调用 C 写的内置函数？能的话返回内置表里的那一项
    被调 = 节点【2】
    如果 被调【0】 不是 “name”：
        返回 空
    名 = 被调【2】
    号 = 查找（内置名表，名）
    如果 号 小于 0 或者 查找（全局被赋值，名） 大于等于 0：
        返回 空
    外 = 环境
    当 外 不是 空 并且 不是 外【模块位】：      # 函数自己或者外层函数有同名的变量：不行
        如果 查找（外【局部位】，名） 大于等于 0：
            返回 空
        外 = 外【外层位】
    项 = 内置表【号】
    个数 = 长度（节点【3】）
    如果 个数 小于 项【2】 或者 （项【3】 大于等于 0 并且 个数 大于 项【3】）：
        返回 空                                 # 个数不对：走普通的路，运行到这里时再报错
    返回 项


函数 可能回收（节点）：
    # 算这个表达式的过程中，会不会发生垃圾回收（也就是会不会调用白话函数）
    种类 = 节点【0】
    如果 种类 是 “num” 或者 种类 是 “str” 或者 种类 是 “const” 或者 种类 是 “name”：
        返回 假
    如果 种类 是 “list”：
        返回 一串可能回收（节点【2】）
    如果 种类 是 “dict”：
        返回 一串可能回收（摊平（节点【2】））
    如果 种类 是 “binop”：
        返回 可能回收（节点【3】） 或者 可能回收（节点【4】）
    如果 种类 是 “compare”：
        如果 可能回收（节点【2】）：
            返回 真
        对于 节点【3】 里的每个 对：
            如果 可能回收（对【1】）：
                返回 真
        返回 假
    如果 种类 是 “and” 或者 种类 是 “or”：
        返回 可能回收（节点【2】） 或者 可能回收（节点【3】）
    如果 种类 是 “not” 或者 种类 是 “neg”：
        返回 可能回收（节点【2】）
    如果 种类 是 “index”：
        返回 可能回收（节点【2】） 或者 可能回收（节点【3】）
    如果 直接内置（节点） 不是 空：
        返回 一串可能回收（节点【3】）
    返回 真


函数 摊平（对们）：
    # 【【键，值】，【键，值】】 -> 【键，值，键，值】
    结果 = 【】
    对于 对们 里的每个 对：
        添加（结果，对【0】）
        添加（结果，对【1】）
    返回 结果


函数 一串可能回收（节点们）：
    对于 节点们 里的每个 节点：
        如果 可能回收（节点）：
            返回 真
    返回 假


函数 后面可能回收（节点们）：
    # 返回一张表：第 i 项表示第 i 个后面的那些里有没有可能回收
    结果 = 【假】 * 长度（节点们）
    有 = 假
    下标 = 长度（节点们） - 1
    当 下标 大于等于 0：
        结果【下标】 = 有
        如果 可能回收（节点们【下标】）：
            有 = 真
        下标 -= 1
    返回 结果


函数 是叶子（语句表）：
    # 没有循环，没有定义函数，所有表达式都不会引起回收
    对于 语句表 里的每个 句：
        种类 = 句【0】
        如果 种类 是 “while” 或者 种类 是 “foreach” 或者 种类 是 “repeat” 或者 种类 是 “def”：
            返回 假
        如果 种类 是 “expr”：
            如果 可能回收（句【2】）：
                返回 假
        否则如果 种类 是 “assign”：
            如果 可能回收（句【4】） 或者 可能回收（句【2】）：
                返回 假
        否则如果 种类 是 “return”：
            如果 句【2】 不是 空 并且 可能回收（句【2】）：
                返回 假
        否则如果 种类 是 “if”：
            对于 句【2】 里的每个 分支：
                如果 可能回收（分支【0】） 或者 不是 是叶子（分支【1】）：
                    返回 假
            如果 句【3】 不是 空 并且 不是 是叶子（句【3】）：
                返回 假
    返回 真


# ---------- 变量的读和写 ----------

函数 全局取值（名）：
    返回 “bh_chk(G[” + 全局槽（名） + “], ” + C文字（名） + “)”


函数 外层取值（名）：
    # 自己这一层没有这个变量，就一层一层往外找，最后找到最外层
    路径 = “up”
    外 = 环境【外层位】
    候选 = 【】
    当 外 不是 空 并且 不是 外【模块位】：
        槽 = 查找（外【局部位】，名）
        如果 槽 大于等于 0：
            添加（候选，路径 + “->v[” + 槽 + “]”）
        路径 = 路径 + “->up”
        外 = 外【外层位】
    结果 = 全局取值（名）
    下标 = 长度（候选） - 1
    当 下标 大于等于 0：
        结果 = “(” + 候选【下标】 + “.tag ? ” + 候选【下标】 + “ : ” + 结果 + “)”
        下标 -= 1
    返回 结果


函数 读变量（名）：
    如果 环境【模块位】：
        临 = 新临时（）
        出（临 + “ = ” + 全局取值（名） + “;”）
        返回 临
    槽 = 查找（环境【局部位】，名）
    声 = 查找（环境【声明位】，名）
    如果 槽 大于等于 0 并且 槽 小于 环境【参数位】 并且 声 小于 0：
        返回 “L[” + 槽 + “]”                          # 参数一定有值，一个式子里也不会被改掉，直接用
    临 = 新临时（）
    如果 槽 大于等于 0：
        前缀 = “”
        如果 声 大于等于 0：
            前缀 = “if (gf” + 声 + “) ” + 临 + “ = ” + 全局取值（名） + “; else ”
        出（前缀 + “if (L[” + 槽 + “].tag) ” + 临 + “ = L[” + 槽 + “]; else { or” + 槽 + “ = 1; ” + 临 + “ = ” + 外层取值（名） + “; }”）
    否则如果 声 大于等于 0：
        出（临 + “ = gf” + 声 + “ ? ” + 全局取值（名） + “ : ” + 外层取值（名） + “;”）
    否则：
        出（临 + “ = ” + 外层取值（名） + “;”）
    返回 临


函数 写变量（名，值式）：
    如果 环境【模块位】：
        出（“G[” + 全局槽（名） + “] = ” + 值式 + “;”）
        返回
    槽 = 查找（环境【局部位】，名）
    声 = 查找（环境【声明位】，名）
    本地 = “if (!L[” + 槽 + “].tag && or” + 槽 + “) bh_modify_outer(” + C文字（名） + “); L[” + 槽 + “] = ” + 值式 + “;”
    如果 槽 小于 环境【参数位】 并且 声 小于 0：
        出（“L[” + 槽 + “] = ” + 值式 + “;”）
    否则如果 声 大于等于 0：
        出（“if (gf” + 声 + “) G[” + 全局槽（名） + “] = ” + 值式 + “; else { ” + 本地 + “ }”）
    否则：
        出（本地）


# ---------- 表达式 ----------

函数 运算函数（符）：
    如果 符 是 “+”：返回 “bh_add”
    如果 符 是 “-”：返回 “bh_sub”
    如果 符 是 “*”：返回 “bh_mul”
    如果 符 是 “/”：返回 “bh_div”
    返回 “bh_mod”


函数 算一串（节点们）：
    # 从左到右算一串值。某个值后面如果还有可能引起回收的，就要保护起来
    式们 = 【】
    后面 = 后面可能回收（节点们）
    下标 = 0
    对于 节点们 里的每个 节点：
        式 = 算（节点）
        如果 后面【下标】：
            式 = 保根（式）
        添加（式们，式）
        下标 += 1
    返回 式们


函数 数组式（式们）：
    如果 长度（式们） 是 0：
        返回 “NULL”
    返回 “(Value[]){” + 连接（式们，“, ”） + “}”


函数 算（节点）：
    # 生成计算这个表达式的 C 代码，返回存着结果的那个 C 表达式
    种类 = 节点【0】
    行 = 节点【1】
    如果 种类 是 “num”：
        返回 数字常量（节点【2】）
    如果 种类 是 “str”：
        返回 “K[” + 常量槽（“文” + 节点【2】） + “]”
    如果 种类 是 “const”：
        如果 节点【2】 是 “真”：返回 “BH_TRUE”
        如果 节点【2】 是 “假”：返回 “BH_FALSE”
        返回 “BH_NIL”
    如果 种类 是 “name”：
        定行（行）
        返回 读变量（节点【2】）
    如果 种类 是 “list”：
        项们 = 算一串（节点【2】）
        临 = 新临时（）
        出（临 + “ = bh_list_make(” + 长度（项们） + “, ” + 数组式（项们） + “);”）
        返回 临
    如果 种类 是 “dict”：                        # 先从左到右算出所有的键和值，再一起放进字典
        项们 = 算一串（摊平（节点【2】））
        定行（行）
        临 = 新临时（）
        出（临 + “ = bh_dict_make(” + 长度（节点【2】） + “, ” + 数组式（项们） + “);”）
        返回 临
    如果 种类 是 “binop”：
        左 = 算（节点【3】）
        如果 可能回收（节点【4】）：
            左 = 保根（左）
        右 = 算（节点【4】）
        定行（行）
        临 = 新临时（）
        出（临 + “ = ” + 运算函数（节点【2】） + “(” + 左 + “, ” + 右 + “);”）
        返回 临
    如果 种类 是 “compare”：
        返回 算比较（节点）
    如果 种类 是 “and” 或者 种类 是 “or”：
        返回 算逻辑（节点）
    如果 种类 是 “not”：
        值 = 算（节点【2】）
        临 = 新临时（）
        出（临 + “ = bh_bool(!bh_truthy(” + 值 + “));”）
        返回 临
    如果 种类 是 “neg”：
        值 = 算（节点【2】）
        定行（行）
        临 = 新临时（）
        出（临 + “ = bh_neg(” + 值 + “);”）
        返回 临
    如果 种类 是 “index”：
        容器 = 算（节点【2】）
        如果 可能回收（节点【3】）：
            容器 = 保根（容器）
        下标 = 算（节点【3】）
        定行（行）
        临 = 新临时（）
        出（临 + “ = bh_index(” + 容器 + “, ” + 下标 + “);”）
        返回 临
    # 剩下的是函数调用
    项 = 直接内置（节点）
    如果 项 不是 空：                            # 内置函数：直接调用 C 函数
        记下（直接调用过，项【0】）
        参数们 = 算一串（节点【3】）
        定行（行）
        临 = 新临时（）
        出（临 + “ = ” + 项【1】 + “(” + 长度（参数们） + “, ” + 数组式（参数们） + “);”）
        返回 临
    # 一般的调用：先算函数本身，再从左到右算参数
    被调 = 算（节点【2】）
    如果 一串可能回收（节点【3】）：
        被调 = 保根（被调）
    参数们 = 算一串（节点【3】）
    定行（行）
    名 = “NULL”
    如果 节点【2】【0】 是 “name”：
        名 = C文字（节点【2】【2】）
    临 = 新临时（）
    出（临 + “ = bh_call(” + 被调 + “, ” + 长度（参数们） + “, ” + 数组式（参数们） + “, ” + 名 + “);”）
    返回 临


函数 算比较（节点）：
    # 连着比（1 小于 x 小于 10）：一个一个比下去，有一个不成立就不用再比了
    临 = 新临时（）
    出（临 + “ = BH_FALSE;”）
    开块（“{”）
    左 = 算（节点【2】）
    层数 = 0
    对于 节点【3】 里的每个 对：
        如果 可能回收（对【1】）：
            左 = 保根（左）
        右 = 算（对【1】）
        定行（节点【1】）
        开块（“if (bh_cmp(” + 查找（比较符号，对【0】） + “, ” + 左 + “, ” + 右 + “)) {”）
        层数 += 1
        左 = 右
    出（临 + “ = BH_TRUE;”）
    重复 层数 + 1 次：
        关块（）
    返回 临


函数 算逻辑（节点）：
    # 并且：左边不成立，就不用算右边了。或者：左边成立，就不用算右边了
    临 = 新临时（）
    开块（“{”）
    左 = 算（节点【2】）
    开块（“if (bh_truthy(” + 左 + “)) {”）
    如果 节点【0】 是 “and”：
        右 = 算（节点【3】）
        出（临 + “ = ” + 右 + “;”）
        否则块（）
        出（临 + “ = ” + 左 + “;”）
    否则：
        出（临 + “ = ” + 左 + “;”）
        否则块（）
        右 = 算（节点【3】）
        出（临 + “ = ” + 右 + “;”）
    关块（）
    关块（）
    返回 临


# ---------- 语句 ----------

函数 编语句表（语句表）：
    对于 语句表 里的每个 句：
        编语句（句）


函数 编语句（句）：
    种类 = 句【0】
    行 = 句【1】
    定行（行）
    用到这里 = 环境【临时位】
    根用到这里 = 环境【根位】
    如果 种类 是 “expr”：
        算（句【2】）
    否则如果 种类 是 “assign”：
        编赋值（句）
    否则如果 种类 是 “if”：
        编如果（句）
    否则如果 种类 是 “while”：
        开块（“for (;;) {”）
        出（“BH_SAFEPOINT();”）
        环境【行位】 = -1
        条件 = 算（句【2】）
        出（“if (!bh_truthy(” + 条件 + “)) break;”）
        编语句表（句【3】）
        关块（）
    否则如果 种类 是 “foreach” 并且 是范围调用（句【2】）：
        # 对于 范围（……）里的每个：参数都是普通整数时不造列表，边数边给（见运行时的 bh_range_begin）
        开块（“{”）
        参数们 = 算一串（句【2】【3】）
        定行（句【2】【1】）
        份 = 根临时（）
        号 = 新整型（）
        区 = “r” + 号
        出（“BhRange ” + 区 + “;”）
        出（“int64_t ” + 号 + “;”）
        出（份 + “ = bh_range_begin(&” + 区 + “, ” + 长度（参数们） + “, ” + 数组式（参数们） + “);”）
        开块（“for (” + 号 + “ = 0; ” + 号 + “ < ” + 区 + “.count; ” + 号 + “++) {”）
        出（“BH_SAFEPOINT();”）
        环境【行位】 = -1
        定行（行）
        写变量（句【3】，“bh_range_at(&” + 区 + “, ” + 份 + “, ” + 号 + “)”）
        编语句表（句【4】）
        关块（）
        关块（）
    否则如果 种类 是 “foreach”：
        # 先把列表抄一份再逐个取出，循环里改原来的列表也不受影响
        开块（“{”）
        来源 = 算（句【2】）
        定行（行）
        份 = 根临时（）                        # 整个循环期间都要留着
        号 = 新整型（）
        出（份 + “ = bh_iter(” + 来源 + “);”）
        出（“int64_t ” + 号 + “;”）
        开块（“for (” + 号 + “ = 0; ” + 号 + “ < bh_list_len(” + 份 + “); ” + 号 + “++) {”）
        出（“BH_SAFEPOINT();”）
        环境【行位】 = -1
        定行（行）
        写变量（句【3】，“bh_list_at(” + 份 + “, ” + 号 + “)”）
        编语句表（句【4】）
        关块（）
        关块（）
    否则如果 种类 是 “repeat”：
        开块（“{”）
        次数 = 算（句【2】）
        定行（行）
        总 = 新整型（）
        号 = 新整型（）
        出（“int64_t ” + 总 + “ = bh_count(” + 次数 + “), ” + 号 + “;”）
        开块（“for (” + 号 + “ = 0; ” + 号 + “ < ” + 总 + “; ” + 号 + “++) {”）
        出（“BH_SAFEPOINT();”）
        环境【行位】 = -1
        编语句表（句【3】）
        关块（）
        关块（）
    否则如果 种类 是 “def”：
        式 = 编函数（句）
        定行（行）
        写变量（句【2】，式）
    否则如果 种类 是 “return”：
        值 = “BH_NIL”
        如果 句【2】 不是 空：
            值 = 算（句【2】）
        如果 环境【叶子位】：
            出（“return ” + 值 + “;”）
        否则：
            出（“BH_RETURN(fr, ” + 值 + “);”）
    否则如果 种类 是 “break”：
        出（“break;”）
    否则如果 种类 是 “continue”：
        出（“continue;”）
    否则如果 种类 是 “global”：
        如果 不是 环境【模块位】：
            对于 句【2】 里的每个 名：
                出（“gf” + 查找（环境【声明位】，名） + “ = 1;”）
    环境【临时位】 = 用到这里
    环境【根位】 = 根用到这里


函数 是范围调用（式）：
    # 是不是直接调用内置的「范围」
    如果 式【0】 不是 “call”：
        返回 假
    项 = 直接内置（式）
    返回 项 不是 空 并且 项【0】 是 “范围”


函数 编赋值（句）：
    行 = 句【1】
    目标 = 句【2】
    运算 = 句【3】
    值 = 算（句【4】）
    如果 运算 不是 “=”：                       # 甲 += 1 就是 甲 = 甲 + 1
        如果 可能回收（目标）：
            值 = 保根（值）
        旧 = 算（目标）
        定行（行）
        临 = 新临时（）
        出（临 + “ = ” + 运算函数（截取（运算，0，1）） + “(” + 旧 + “, ” + 值 + “);”）
        值 = 临
    如果 目标【0】 是 “name”：
        定行（行）
        写变量（目标【2】，值）
    否则：                                     # 列表【下标】 = 值
        如果 可能回收（目标）：
            值 = 保根（值）
        容器 = 算（目标【2】）
        如果 可能回收（目标【3】）：
            容器 = 保根（容器）
        下标 = 算（目标【3】）
        定行（行）
        出（“bh_set_index(” + 容器 + “, ” + 下标 + “, ” + 值 + “);”）


函数 编如果（句）：
    层数 = 0
    对于 句【2】 里的每个 分支：
        条件 = 算（分支【0】）
        开块（“if (bh_truthy(” + 条件 + “)) {”）
        编语句表（分支【1】）
        否则块（）
        层数 += 1
    如果 句【3】 不是 空：
        编语句表（句【3】）
    重复 层数 次：
        关块（）


函数 编函数（句）：
    # 把一个白话函数编译成一个 C 函数，返回「创建这个函数值」的 C 表达式
    全局 环境，函数个数
    函数个数 += 1
    编号 = 函数个数
    局部 = 【】
    并入（局部，句【3】）
    声明 = 【】
    标记 = 【假】
    收集（句【4】，局部，声明，标记）
    外面 = 环境
    环境 = 新环境（外面，局部，长度（句【3】），声明，标记【0】，假）
    环境【叶子位】 = 不是 标记【0】 并且 是叶子（句【4】）
    编语句表（句【4】）
    头 = 【“static Value fn” + 编号 + “(Frame *up, Value *a) {    /* 函数 ” + 句【2】 + “，第 ” + 句【1】 + “ 行 */”】
    根数 = 环境【最多根位】
    如果 环境【叶子位】：
        # 叶子函数：执行过程中不会回收，变量放在普通的 C 数组里就行
        添加（头，“    Value L[” + 至少一（长度（局部）） + “] = {{0}};”）
    否则如果 标记【0】：
        # 里面还定义了函数：局部变量放到堆上，这个函数结束以后内层函数还能接着用
        添加（头，“    struct { BhRoots h; Value v[” + （根数 + 1） + “]; } fr;”）
        添加（头，“    Frame *self; Value *L, *T;”）
        添加（头，“    BH_ENTER(fr, ” + （根数 + 1） + “);”）
        添加（头，“    self = bh_frame_new(up, ” + 长度（局部） + “); fr.v[0] = bh_obj(T_FRAME, self); L = self->v; T = fr.v + 1;”）
    否则：
        内层 = 不是 外面【模块位】          # 定义在函数里面的函数：外层的变量（up）也要登记
        格数 = 长度（局部） + 根数
        如果 内层：
            格数 += 1
        添加（头，“    struct { BhRoots h; Value v[” + 至少一（格数） + “]; } fr;”）
        添加（头，“    Value *L, *T;”）
        添加（头，“    BH_ENTER(fr, ” + 至少一（格数） + “);”）
        添加（头，“    L = fr.v; T = fr.v + ” + 长度（局部） + “;”）
        如果 内层：
            添加（头，“    fr.v[” + （格数 - 1） + “] = bh_obj(T_FRAME, up);”）
    添加C临时（头）
    下标 = 0
    当 下标 小于 长度（局部）：
        如果 下标 小于 长度（句【3】）：
            添加（头，“    L[” + 下标 + “] = a[” + 下标 + “];    /* ” + 局部【下标】 + “ */”）
        添加（头，“    char or” + 下标 + “ = 0;”）
        下标 += 1
    下标 = 0
    当 下标 小于 长度（声明）：
        添加（头，“    char gf” + 下标 + “ = 0;”）
        下标 += 1
    结尾 = “    return BH_NIL;”
    如果 不是 环境【叶子位】：
        添加（头，“    BH_SAFEPOINT();”）
        结尾 = “    BH_RETURN(fr, BH_NIL);”
    添加（函数成品，连接（头 + 环境【代码位】 + 【结尾，“}”，“”】，“\n”））
    环境 = 外面
    框 = “NULL”
    如果 不是 外面【模块位】：
        框 = “self”
    返回 “bh_func(fn” + 编号 + “, ” + 长度（句【3】） + “, ” + C文字（句【2】） + “, ” + 框 + “)”


函数 添加C临时（头）：
    # 在函数开头声明用到的普通临时变量 t0、t1……
    如果 环境【最多位】 大于 0：
        名们 = 【】
        下标 = 0
        当 下标 小于 环境【最多位】：
            添加（名们，“t” + 下标）
            下标 += 1
        添加（头，“    Value ” + 连接（名们，“, ”） + “;”）


函数 编译（源码，文件名，运行时）：
    # 整个编译过程：源代码进，C 代码出
    全局 源码行表，记号，游标，环境
    源码 = 连接（分割（源码，字符（13） + “\n”），“\n”）
    源码 = 连接（分割（源码，字符（13）），“\n”）
    源码行表 = 分割（源码，“\n”）
    记号 = 词法分析（）
    游标 = 0
    树 = 解析程序（）
    读内置表（运行时）
    找全局赋值（树，真）
    环境 = 新环境（空，【】，0，【】，假，真）
    编语句表（树）
    主体 = 环境【代码位】
    模块头 = 【】
    添加C临时（模块头）

    如果 查找（文件名，“*/”） 大于等于 0：
        文件名 = “程序”
    成品 = 【“/* 由白话编译器生成，源文件：” + 文件名 + “ */”，运行时】

    名字们 = 【】
    对于 全局名表 里的每个 名：
        添加（名字们，C文字（名））
    添加（名字们，“NULL”）
    添加（成品，“static Value G[” + 至少一（长度（全局名表）） + “];”）
    添加（成品，“static const char *bh_gnames[] = {” + 连接（名字们，“, ”） + “};”）
    添加（成品，“static Value K[” + 至少一（长度（常量表）） + “];”）

    添加（成品，“static const char *bh_srclines[] = {”）
    对于 源码行表 里的每个 一行：
        添加（成品，“    ” + C文字（去空白（一行）） + “,”）
    添加（成品，“    NULL};”）

    带源码 = 查找（全局名表，“运行时源码”） 大于等于 0 或者 查找（直接调用过，“运行时源码”） 大于等于 0   # 只有编译器自己才需要带着运行时的源码
    如果 带源码：
        添加（成品，“static const char *bh_rtsource[] = {”）
        片们 = 分割（运行时，“\n”）
        下标 = 0
        当 下标 小于 长度（片们）：
            一行 = 片们【下标】
            如果 下标 小于 长度（片们） - 1：
                一行 = 一行 + “\n”
            添加（成品，“    ” + C文字（一行） + “,”）
            下标 += 1
        添加（成品，“    NULL};”）

    添加（成品，“”）
    下标 = 1
    当 下标 小于等于 函数个数：
        添加（成品，“static Value fn” + 下标 + “(Frame *up, Value *a);”）
        下标 += 1
    添加（成品，“”）
    并入（成品，函数成品）
    格数 = 至少一（环境【最多根位】）
    添加（成品，“static void bh_module(void) {”）
    添加（成品，“    struct { BhRoots h; Value v[” + 格数 + “]; } fr;”）
    添加（成品，“    Value *T;”）
    并入（成品，模块头）
    添加（成品，“    BH_ENTER(fr, ” + 格数 + “);”）
    添加（成品，“    T = fr.v;”）
    并入（成品，主体）
    添加（成品，“    bh_roots = fr.h.prev;”）
    添加（成品，“}”）
    添加（成品，“”）
    添加（成品，“int main(int argc, char **argv) {”）
    添加（成品，“    char base;”）
    添加（成品，“    bh_init(argc, argv, &base);”）
    添加（成品，“    bh_src = bh_srclines;”）
    添加（成品，“    bh_src_n = ” + 长度（源码行表） + “;”）
    如果 带源码：
        添加（成品，“    bh_rt_lines = bh_rtsource;”）
        添加（成品，“    bh_rt_lines_n = ” + 长度（分割（运行时，“\n”）） + “;”）
    添加（成品，“    bh_init_globals(G, bh_gnames, ” + 长度（全局名表） + “, K, ” + 长度（常量表） + “);”）
    下标 = 0
    当 下标 小于 长度（常量表）：
        项 = 常量表【下标】
        制造 = “bh_str_lit(”
        如果 截取（项，0，1） 是 “数”：
            制造 = “bh_big_lit(”
        添加（成品，“    K[” + 下标 + “] = ” + 制造 + C文字（截取（项，1，长度（项））） + “);”）
        下标 += 1
    添加（成品，“    bh_module();”）
    添加（成品，“    fflush(stdout);”）
    添加（成品，“    return 0;”）
    添加（成品，“}”）
    添加（成品，“”）
    返回 连接（成品，“\n”）


# ======================================================================
# 入口：看命令行参数，读文件，编译，调用 C 编译器
# ======================================================================

函数 引（文）：
    # 给命令里的文件名加上引号，这样名字里有空格也不怕
    返回 “'” + 连接（分割（文，“'”），“'\\''”） + “'”


函数 主程序（）：
    参数表 = 命令行参数（）
    输入文件 = 空
    输出名 = 空
    只要C = 假
    C编译器 = “cc”
    运行时文件 = 空
    下标 = 0
    当 下标 小于 长度（参数表）：
        项 = 参数表【下标】
        有下一个 = 下标 + 1 小于 长度（参数表）
        如果 项 是 “-o” 并且 有下一个：
            输出名 = 参数表【下标 + 1】
            下标 += 1
        否则如果 项 是 “--cc” 并且 有下一个：
            C编译器 = 参数表【下标 + 1】
            下标 += 1
        否则如果 项 是 “--runtime” 并且 有下一个：
            运行时文件 = 参数表【下标 + 1】
            下标 += 1
        否则如果 项 是 “--emit-c”：
            只要C = 真
        否则如果 输入文件 是 空 并且 截取（项，0，1） 不是 “-”：
            输入文件 = 项
        否则：
            报错（“看不懂的参数：” + 项）
            退出（2）
        下标 += 1
    如果 输入文件 是 空：
        报错（“用法：baihuac 程序.bh [-o 输出名] [--emit-c] [--cc C编译器]”）
        退出（2）

    源码 = 读文件（输入文件）
    如果 源码 是 空：
        报错（“打不开文件：” + 输入文件）
        退出（1）
    如果 运行时文件 是 空：
        运行时 = 运行时源码（）
    否则：
        运行时 = 读文件（运行时文件）
        如果 运行时 是 空：
            报错（“打不开文件：” + 运行时文件）
            退出（1）

    基名 = 输入文件 + “.out”
    如果 长度（输入文件） 大于 3 并且 截取（输入文件，长度（输入文件） - 3，3） 是 “.bh”：
        基名 = 截取（输入文件，0，长度（输入文件） - 3）

    C代码 = 编译（源码，输入文件，运行时）

    如果 只要C：
        如果 输出名 是 空：
            输出名 = 基名 + “.c”
        如果 不是 写文件（输出名，C代码）：
            报错（“写不了文件：” + 输出名）
            退出（1）
        返回

    如果 输出名 是 空：
        输出名 = 基名
    C文件 = 输出名 + “.c”
    如果 不是 写文件（C文件，C代码）：
        报错（“写不了文件：” + C文件）
        退出（1）
    状态 = 运行命令（C编译器 + “ -O2 -w -o ” + 引（输出名） + “ ” + 引（C文件） + “ -lm”）
    如果 状态 不是 0：
        报错（“调用 C 编译器（” + C编译器 + “）没有成功。生成的 C 代码留在 ” + C文件 + “ 里。”）
        退出（1）
    运行命令（“rm -f ” + 引（C文件））
    打印（“编译好了：” + 输出名）


主程序（）
