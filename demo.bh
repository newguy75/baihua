# 白话语言示例程序
# 这个文件里的括号、逗号、冒号、引号全部是中文符号，不用切换输入法。
# 运行：python3 baihua.py demo.bh

# 一、变量和打印
名字 = “小明”
年龄 = 18
打印（“你好，” + 名字 + “！你今年 ” + 年龄 + “ 岁。”）

# 二、判断
如果 年龄 大于等于 18：
    打印（“成年了”）
否则：
    打印（“还没成年”）

# 三、函数
函数 打招呼（名字）：
    如果 名字 是 “小明”：
        打印（“你好，小明”）
    否则：
        打印（“你是谁？”）

打招呼（“小明”）
打招呼（“路人甲”）

# 四、循环（范围两头都算：范围（1，100）就是 1 到 100）
重复 3 次：
    打印（“加油！”）

总和 = 0
对于 范围（1，100）里的每个 数：
    总和 = 总和 + 数
打印（“1 加到 100 等于”，总和）

对于 范围（10，16）里的每个 数：
    如果 数 % 3 是 0 并且 数 % 5 是 0：
        打印（数，“能被 3 和 5 整除”）
    否则如果 数 % 3 是 0 或者 数 % 5 是 0：
        打印（数，“能被 3 或 5 整除”）

# 五、列表（顿号和逗号都可以用来分隔，下标从 0 开始数）
水果 = 【“苹果”、“香蕉”、“西瓜”】
添加（水果，“荔枝”）
对于 水果 里的每个 果子：
    打印（“我爱吃” + 果子）
打印（“一共”，长度（水果），“种：”，水果）

# 六、递归
函数 斐波那契（n）：
    如果 n 小于 2：
        返回 n
    返回 斐波那契（n - 1） + 斐波那契（n - 2）

打印（“斐波那契数列第 20 项是”，斐波那契（20））

# 七、九九乘法表
行 = 1
当 行 小于等于 9：
    这一行 = “”
    列 = 1
    当 列 小于等于 行：
        这一行 = 这一行 + 列 + “×” + 行 + “=” + 列 * 行 + “  ”
        列 = 列 + 1
    打印（这一行）
    行 = 行 + 1

# 八、英文符号照样能用，可以混着写
打印("半角的括号和引号也可以", 1 + 2 * 3)
